---
interface Props {
	title: string;
	description?: string;
	unitTitle?: string; // set on unit pages to show a breadcrumb
}
const { title, description = '工程數學互動教材', unitTitle } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="zh-Hant">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="description" content={description} />
	<title>{title}</title>
	<link rel="icon" href={`${base}favicon.svg`} />
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+TC:wght@400;500;700;800&display=swap"
		rel="stylesheet"
	/>
	<style is:global>
		:root {
			--bg: #ffffff;
			--bg-canvas: #f6f6f7;
			--card: #ffffff;
			--card-soft: #fafafa;
			--card-hover: #f2f2f3;
			--border: #e4e4e7;
			--border-soft: #ededef;
			--fg: #18181b;
			--muted: #71717a;
			--muted-soft: #a1a1aa;
			--accent: #2563eb;
			--accent-strong: #1d4ed8;
			--accent-soft: #eaf1fd;
			--good: #16a34a;
			--good-soft: #eafbf0;
			--bad: #dc2626;
			--bad-soft: #fdecec;
			--radius: 14px;
			--radius-sm: 10px;
			color-scheme: light;
		}
		* { box-sizing: border-box; }
		html, body { margin: 0; padding: 0; }
		body {
			background: var(--bg);
			color: var(--fg);
			font-family: "Inter", "Noto Sans TC", "Segoe UI", system-ui, sans-serif;
			line-height: 1.7;
			-webkit-font-smoothing: antialiased;
		}
		a { color: inherit; }
		.wrap { max-width: 960px; margin: 0 auto; padding: 1.5rem 1.25rem 5rem; }

		/* Shared header */
		header.site-header {
			display: flex; justify-content: space-between; align-items: center;
			gap: 1rem; flex-wrap: wrap; padding: 1rem 0 1.25rem;
			border-bottom: 1px solid var(--border-soft); margin-bottom: 0.5rem;
		}
		.brand-row { display: flex; align-items: center; gap: 0.65rem; text-decoration: none; }
		.brand-mark {
			width: 30px; height: 30px; border-radius: 7px; display: grid; place-items: center;
			background: var(--fg); font-weight: 700; font-size: 0.95rem; color: var(--bg); flex-shrink: 0;
			font-family: "Georgia", serif;
		}
		.brand-name { font-weight: 800; font-size: 1.02rem; letter-spacing: -0.01em; }
		.beta-badge {
			display: inline-block; margin-left: 0.45rem; font-size: 0.62rem; font-weight: 700;
			color: var(--muted); background: var(--card-hover); border: 1px solid var(--border);
			padding: 0.12rem 0.45rem; border-radius: 999px; vertical-align: middle; letter-spacing: 0.04em;
		}
		.crumb-sep { color: var(--muted-soft); margin: 0 0.15rem; }
		.crumb-unit { color: var(--muted); font-size: 0.92rem; font-weight: 600; }
		.header-nav { display: flex; align-items: center; gap: 1rem; }
		.header-nav a {
			font-size: 0.85rem; color: var(--muted); text-decoration: none; font-weight: 600;
		}
		.header-nav a:hover { color: var(--accent); }
		#langToggle {
			border: 1px solid var(--border); background: var(--card); color: var(--fg);
			padding: 0.5rem 1.1rem; border-radius: 999px; cursor: pointer; font-size: 0.85rem;
			white-space: nowrap; transition: border-color 0.15s ease, background 0.15s ease;
		}
		#langToggle:hover { border-color: var(--accent); background: var(--card-hover); }

		footer.site-footer {
			margin-top: 3.5rem; color: var(--muted-soft); font-size: 0.8rem;
			border-top: 1px solid var(--border-soft); padding-top: 1.4rem;
		}

		/* Shared building blocks used by both the homepage and unit pages */
		.card {
			background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
			box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
		}
	</style>
</head>
<body>
	<div class="wrap">
		<header class="site-header">
			<a class="brand-row" href={base}>
				<div class="brand-mark">∫</div>
				<span class="brand-name" data-chrome-i18n="brandName">工程數學互動教材<span class="beta-badge">BETA</span></span>
			</a>
			{unitTitle && (
				<span class="crumb-unit"><span class="crumb-sep">/</span> <span data-i18n="unitBreadcrumb">{unitTitle}</span></span>
			)}
			<nav class="header-nav">
				<a href={`${base}glossary`} data-chrome-i18n="navGlossary">名詞解釋</a>
				<button id="langToggle" type="button">EN</button>
			</nav>
		</header>

		<slot />

		<footer class="site-footer">
			<p data-chrome-i18n="footerNote">內容改寫自課堂講義（賴以威，工程數學）。此網站為互動教材原型，持續擴充中。</p>
		</footer>
	</div>

	<script>
		import { getStoredLang, setStoredLang, type Lang } from '../lib/i18n';

		const chromeDict: Record<Lang, Record<string, string>> = {
			zh: {
				brandName: '工程數學互動教材',
				navGlossary: '名詞解釋',
				footerNote: '內容改寫自課堂講義（賴以威，工程數學）。此網站為互動教材原型，持續擴充中。',
			},
			en: {
				brandName: 'Engineering Math — Interactive Courseware',
				navGlossary: 'Glossary',
				footerNote: 'Content adapted from course slides (I-Wei Lai, Engineering Mathematics). This is an evolving courseware prototype.',
			},
		};

		let lang: Lang = getStoredLang();

		function applyChrome() {
			document.documentElement.lang = lang === 'zh' ? 'zh-Hant' : 'en';
			document.querySelectorAll<HTMLElement>('[data-chrome-i18n]').forEach((el) => {
				const key = el.dataset.chromeI18n!;
				const text = chromeDict[lang][key];
				if (text === undefined) return;
				// Preserve any nested elements (like the BETA badge) by only touching the first text node.
				const firstText = Array.from(el.childNodes).find((n) => n.nodeType === Node.TEXT_NODE);
				if (firstText) firstText.textContent = text;
				else el.prepend(document.createTextNode(text));
			});
			const toggle = document.getElementById('langToggle');
			if (toggle) toggle.textContent = lang === 'zh' ? 'EN' : '中文';
		}

		document.getElementById('langToggle')?.addEventListener('click', () => {
			lang = lang === 'zh' ? 'en' : 'zh';
			setStoredLang(lang);
			applyChrome();
			window.dispatchEvent(new CustomEvent('langchange', { detail: { lang } }));
		});

		applyChrome();
	</script>
</body>
</html>
